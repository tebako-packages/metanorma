      macos-x86_64: "8cd3766355eb122680fb7532e67bcadb7c92d2d31fba24cb2babdd8be1e005fa"
      linux-gnu-x86_64: "9618711295d785d7dfb32c00a74a40db32c0846eeaae4f18ffbaeab662e167bd"
      linux-gnu-arm64: "4cb3a6a74bb2ae3c080465cffe8ef6a1b1d1cc064f8a600c998882f6ca044224"
      linux-musl-x86_64: "f2059cd4e90ea7cae27831a265dac4d588a9555296cda0d542a2895432a397a3"
      linux-musl-arm64: "162436f8c9bb7cd9fe69f5a1d40312912d72d163f71781d0c649803060563f13"
      windows-ucrt64: "ff6e2fb9ca469bafb7752a59ae608cd734009d4a56279efad5b7d401fa071fc6"
    tebako-shim:
      macos-arm64: "90cff0a64219a9e3d09b79780c0be3b85e8abac0c6a1766dddf9f6b8a4a743bf"
      macos-x86_64: "0839ba5b4bb4b73738ce1b304219f00ce648adaf6644b29f5bf52be6b75a1ba1"
      linux-gnu-x86_64: "88afbd4d35ad74474c64d07a5dd4f4fb951c7225efa1636b12c05f126c838949"
      linux-gnu-arm64: "aec73db4dcec581719814e9cdc409fbdce9b1dc64d8cf3792439fa19544e049b"
      linux-musl-x86_64: "cebd1dce4937d1a93b8d4040042c987e20c8ec9f77f2a72c2d8975b0d1a50aad"
      linux-musl-arm64: "0a9efd19dc43632a38f6f1c28a5aa7c3c94105365642c233be2f982044e1f768"
      windows-ucrt64: "9725a16e579a2d89282aae2a67c2bb82569fafcbb4b3fdb0e668614eca66c5b1"
