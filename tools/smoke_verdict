#!/usr/bin/env bash
# tools/smoke_verdict <rc> <log> — the windows leg's boot-smoke verdict,
# ENFORCING since the runtime pin moved to the 0.16.4 line: any exec
# failure fails the leg (fail-closed).
#
# The two RUNTIME-LAYER gaps this file used to tolerate
# (docs/build-notes.md § Windows) are CLOSED on the 0.16.4 line (the
# re-cut release — tebako-runtime-ruby run 32346716268):
#
#   G1 mount addressing — CLOSED by the spec-17 uniform namespace /
#      era-2 image layout (payload requires no longer escape the VFS as
#      a drive-relative re-root onto the cwd drive).
#   G2 no dynamic native extensions — CLOSED by the ruby DLL facet +
#      the loader interpose + library_aliases: (spec 22 phase W2; the
#      facet ships as x64-ucrt-ruby330.dll next to the stub exe, so
#      nokogiri/ffi/ox/psych/... .so files have a symbol provider).
#
# The verdict contract is now fail-closed:
#
#   rc == 0                  → PASS. (Follow-up, once green: wire the
#                              windows artifact into the publish job +
#                              tpkg-registry.yaml.)
#   rc != 0 + the old G1/G2 LoadError signature
#                            → RED: a REGRESSION of the 0.16.4 windows
#                              fixes (or the wrong runtime resolved) —
#                              named, never tolerated.
#   anything else            → RED: an undiagnosed failure.
set -euo pipefail

rc="${1:?usage: tools/smoke_verdict <rc> <log>}"
log="${2:?usage: tools/smoke_verdict <rc> <log>}"

if [ "$rc" -eq 0 ]; then
  echo "BOOT SMOKE PASSED on windows-ucrt64 against the 0.16.4 runtime line"
  echo "(enforcing gate). Follow-up: wire the windows artifact into the"
  echo "publish job + tpkg-registry.yaml."
  exit 0
fi

if grep -q "LoadError" "$log" && grep -qiE "cannot load such file -- (metanorma|nokogiri|ffi|brotli|ox|liboga|libll|psych|sqlite3|libpng|parsanol|websocket)" "$log"; then
  echo "BOOT SMOKE REGRESSION (rc=$rc): the log carries the pre-0.16.4"
  echo "runtime-layer signature (G1 mount addressing / G2 no dynamic native"
  echo "extensions). Those gaps are CLOSED on the 0.16.4 line — the runtime"
  echo "regressed or the wrong runtime resolved. Failing the leg."
  exit 1
fi

echo "BOOT SMOKE failed in an UNRECOGNIZED way (rc=$rc). Full log above."
exit 1
