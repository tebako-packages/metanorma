#!/usr/bin/env bash
# tools/boot_smoke <image.tfs> — the release gate (conventions.md):
# assert the entrypoint exists in the image and runs under a published
# tebako runtime.
#
# Env: TFS (tfs CLI binary), RUNTIME (tebako runtime exe), RUNTIME_IMAGE
#      (the runtime's env .tfs). The exec leg uses the spec 17 driver
#      handoff directly (image-era runtime ABI): the payload mounts bare
#      at "/", the env image rides TEBAKO_RUNTIME_IMAGE.
set -euo pipefail

IMG="${1:?usage: tools/boot_smoke <image.tfs>}"
TFS="${TFS:-tfs}"
RUNTIME="${RUNTIME:?set RUNTIME to the tebako runtime exe (tools/build writes out/<triplet>/runtime.env)}"
RUNTIME_IMAGE="${RUNTIME_IMAGE:?set RUNTIME_IMAGE to the runtime env .tfs}"

# Under MSYS2 every VFS-path argv element ("/bin/metanorma" & co., incl.
# --flag=value forms) would be path-converted to a host path; native
# tools must see them verbatim. Inert on POSIX.
export MSYS2_ARG_CONV_EXCL='*'

echo "== entrypoint assertions (in-process mount via libtfs)"
"$TFS" stat "$IMG" /bin/metanorma | grep -q File
"$TFS" stat "$IMG" /local/stub.rb | grep -q File
"$TFS" ls "$IMG" /lib/ruby/gems/3.3.0/gems | grep -q "metanorma-cli-1.16.9"
echo "   /bin/metanorma, /local/stub.rb, gem tree: present"

echo "== extract round-trip"
X="$(mktemp -d)"
# the extract dest is a HOST path for the native tool: with conversion
# shielded (above), hand it the windows form explicitly (inert on POSIX)
XDEST="$X"
command -v cygpath >/dev/null 2>&1 && XDEST="$(cygpath -m "$X")"
"$TFS" extract -d "$XDEST" "$IMG"
[ -f "$X/bin/metanorma" ] || { echo "extracted entrypoint missing"; exit 1; }

echo "== exec metanorma version with a published tebako runtime"
TEBAKO_RUNTIME_IMAGE="$RUNTIME_IMAGE" \
  "$RUNTIME" "--tebako-image=$IMG:-:/" "--tebako-entry=/bin/metanorma" version \
  | grep -E "Metanorma::Cli 1.16.9"
echo "BOOT-SMOKE-OK"
