# Preloaded (RUBYOPT) into every runtime-ruby process of the staging build
# that runs mkmf (the per-triplet source builds (brotli, ox, psych, websocket-driver)). The tebako runtime
# image carries no ruby headers and no libruby archive; point mkmf at the
# SDK header dir (assembled by tools/build from the pinned ruby source
# tarball) and link extensions the darwin way. @@SDK_INCLUDE@@ is
# substituted by tools/build.
unless defined?(TG_SDK_PATCHED)
  TG_SDK_PATCHED = true
  sdk = "@@SDK_INCLUDE@@"
  [RbConfig::CONFIG, RbConfig::MAKEFILE_CONFIG].each do |c|
    c["rubyhdrdir"] = sdk
    c["rubyarchhdrdir"] = File.join(sdk, "arm64-darwin24")
    c["LIBRUBYARG"] = "-Wl,-undefined,dynamic_lookup"
    c["LIBRUBYARG_STATIC"] = "-Wl,-undefined,dynamic_lookup"
    c["LIBRUBYARG_SHARED"] = "-Wl,-undefined,dynamic_lookup"
    c["DLDFLAGS"] = c["DLDFLAGS"].to_s.gsub(/-bundle_loader\s+('\S+'|\S+)/, "")
    c["EXTDLDFLAGS"] = ""
  end
end
