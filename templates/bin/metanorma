#!/usr/bin/env ruby
# frozen_string_literal: true

# tebako-packages/metanorma payload entrypoint (kind: app, runtime-required).
#
# The payload image can be mounted at an arbitrary point by the dispatcher
# (spec 07 mounts it at "/"), so the gem home is derived from this file's
# own location instead of being baked in. The language runtime's default
# gem dir (its own image) supplies the default gems this closure relies on
# (json, bigdecimal, strscan, racc, rexml, date, ... — see docs/build-notes.md).

# Windows mount-addressing (provisional, until the runtime grows a
# convention): the mount triple grammar cannot carry a drive-letter mount
# point, so the payload mounts at "/" — but ruby on windows re-roots
# drive-relative absolute paths onto the cwd drive (File.expand_path —
# rubygems calls it on every globbed gemspec with the VFS dir as base) or
# the GetFullPathNameW answer (File.realpath), both of which would escape
# the VFS ("D:/lib/..." is a host path). Keep VFS-rooted paths literal:
# the VFS owns the "/" namespace and holds no symlinks, so the lexical
# form IS the resolved form. Host paths (A:/t, drive letters, cwd-based
# relatives) keep the real semantics.
if RUBY_PLATFORM =~ /mingw|mswin/
  class << File
    alias_method :__tebako_payload_expand_path, :expand_path
    alias_method :__tebako_payload_realpath, :realpath

    def __tebako_payload_vfs_lexical(path, base)
      absolute = path.match?(%r{\A(/|[A-Za-z]:[/\\])})
      joined = absolute ? path.dup : File.join(base, path)
      parts = joined.split("/").each_with_object([]) do |c, acc|
        next acc if c.empty? || c == "."
        c == ".." ? acc.pop : acc.push(c)
      end
      joined.start_with?("/") ? "/#{parts.join('/')}" : parts.join("/")
    end

    # MRI's File.expand_path/realpath accept any path-like (Pathname
    # included — git 3.1.1's normalize_working_directory passes one, round-3
    # windows leg); the shim must keep that contract. String#to_s returns
    # self, so the coercion is free for the common case.
    def expand_path(path, base = Dir.pwd)
      path = path.to_s
      if path.start_with?("/") || base.to_s.start_with?("/")
        __tebako_payload_vfs_lexical(path, base)
      else
        __tebako_payload_expand_path(path, base)
      end
    end

    def realpath(path, base = nil)
      # File.realpath takes an optional base (Pathname#realpath passes one
      # on ruby 3.3 — metanorma-cli's exe hits exactly that call).
      path = path.to_s
      if path.start_with?("/") || base.to_s.start_with?("/")
        __tebako_payload_vfs_lexical(path, base || Dir.pwd)
      elsif base.nil?
        __tebako_payload_realpath(path)
      else
        __tebako_payload_realpath(path, base)
      end
    end
  end
end

# File.expand_path("..", __dir__) would already re-root "/bin" onto the
# cwd drive on windows; File.dirname stays lexical.
root = File.dirname(__dir__)
# The ruby-API segment (lib/ruby/gems/<3.3.0|4.0.0|...>) is per ruby line
# — derive it: the payload carries exactly one API dir, so
# the glob is unambiguous; zero or two is assembly drift, fail closed.
api_dirs = Dir[File.join(root, "lib/ruby/gems/*")].select { |d| File.directory?(d) }
abort("metanorma: expected exactly one lib/ruby/gems/<api> dir in the payload, " \
      "found #{api_dirs.length} — payload assembly drift") unless api_dirs.length == 1
gem_dir = api_dirs.first

ENV["GEM_HOME"] = gem_dir
ENV["GEM_PATH"] = [gem_dir, Gem.default_dir].join(File::PATH_SEPARATOR)
Gem.clear_paths

# Extension slices (the manifest's declared extension point, spec 03 §2.8):
# each installed flavor slice mounts a mini GEM_HOME at /flavors.d/<name>.
# Put every mounted home on the search path, then require the slice-named
# gem — flavors self-register on require (Metanorma::Registry), exactly
# like metanorma-cli's own flavor loader; a slice whose gems are only on
# GEM_PATH but never required stays inert. A failing require is a broken
# slice — the LoadError surfaces as-is (loud, never swallowed). The paths
# are VFS-rooted literals and ride the windows lexical discipline above.
# Zero slices mounted = the guard skips (the stock payload is unchanged).
flavors = "/flavors.d"
if File.directory?(flavors)
  Dir[File.join(flavors, "*")].sort.each do |home|
    next unless File.directory?(home)
    Gem.paths = { "GEM_PATH" => Gem.path + [home] }
    require File.basename(home)
  end
end

gem "metanorma-cli", "= 1.16.9"
load Gem.bin_path("metanorma-cli", "metanorma", "1.16.9")
