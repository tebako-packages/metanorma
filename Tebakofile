# Feedstock recipe for metanorma
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "metanorma"
kind: app
summary: "Metanorma — the standards-document authoring CLI (ruby app; runtime-required payload)"

upstream:
  # RubyGems closure, not a tarball: the dependency set is resolved from the
  # rubygems compact index and every .gem is sha256-verified against the
  # /info/<gem> checksum before use (tools/build).
  gem: "metanorma-cli"
  version: "1.17.0"
  source: "https://rubygems.org"

build:
  system: gemstage         # stage a GEM_HOME closure with a tebako runtime's own ruby
  runtime:
    engine: ruby
    tebako: "0.16.31"      # runtime release line (image-era; the pinned CLI
                           # refuses pre-era releases by contract, exit 75).
                           # 0.16.31 re-links on tebako v2.8.21 (the 64 MiB
                           # limnifs inline-metadata ceiling — this payload
                           # images ≈7.9 MiB of inline metadata, EINVAL to
                           # any older driver) + the min_runtime_tebako
                           # enforcement plane.
                           # 0.16.30 re-cuts the catalog on ruby source
                           # v0.2.38 (the spawn argv[0] fidelity fix,
                           # ruby#121): a spawned subprocess now sees the
                           # entrypoint's argv[0] instead of the loader
                           # path — jing-driven compiles stop aborting
                           # (tebako#669 bug 2; proven green locally on a
                           # 3.3.12/0.16.30 build pre-publish, then on the
                           # full catalog run).
                           # 0.16.24 re-cuts the signed line on the tebako
                           # v2.8.7 link unit (the windows 0xC0000139
                           # mount-boundary repair) — the first line whose
                           # shards declare OpenPGP signature facets.
                           # 0.16.23 is the SIGNED re-cut of the 0.16.22
                           # line (spec 09 §9 publish signing + spec 34
                           # OS-plane signing — same sources, new assets).
                           # 0.16.22 is the factory re-cut on the tebako
                           # v2.2.0 link unit (the spec-32 driver plan +
                           # schema_minor-5 parse) — it UNBLOCKS the
                           # xml2rfc executable edge below: pre-0.16.22
                           # exes refused the manifest at boot by name
                           # ("requires.[3].kind: unknown variant
                           # `executable`" — proven 2026-09-05 with the
                           # local spec-32 build on the 0.16.19/0.16.21
                           # lines; 0.16.21 still rode the tebako v2.1.5
                           # link unit per the factory's contract.yml
                           # link_unit_release). 0.16.18 carries the tebako
                           # v2.1.0 link unit AND the spec-30 spawn FFI
                           # head (ruby#106's process_c_tebako_spawn patch
                           # — array-form spawns of an exposed command
                           # offer the driver's plan FIRST; without it the
                           # java edge cannot intercept mn2pdf/jing's
                           # spawns on POSIX). Ruby source pin v0.2.32.
                           # 0.16.19 rides the tebako v2.1.5 link unit
                           # (tebako#516: the realpath NULL-buffer arm
                           # routes to canonicalize_file_name — the
                           # glibc ≤ 2.31 compat-twin EINVAL that refused
                           # every jailed spawn, exit 78, on the factory
                           # floor; tebako#517 scopes that reroute to gnu —
                           # musl has no canonicalize_file_name at all and
                           # its plain-dlsym arm is already unambiguous, so
                           # the v2.1.4 musl unit's constructor panicked on
                           # the RTLD_NEXT lookup; tebako#515's realpath
                           # family + vfork gate included).
    # The ruby axis (roadmap 77): ONE upstream version publishes ONE
    # registry version entry per line — the default line keeps the bare
    # upstream version (1.17.0), every other line suffixes "-ruby<line>"
    # (1.17.0-ruby3.3). Users choose through the existing spec 07 §2.1
    # version chain; each flavor's entrypoint runtime_requirement fills
    # from the line's `constraint` (spec 28 §8's native law locks each
    # flavor to its own ABI line — never cross-paired). Per line:
    #   version    — the staging + exec runtime (tebako-runtime-ruby)
    #   constraint — the ABI line declared on every entrypoint
    #   sdk        — mkmf SDK for the source-built native deps (brotli, ox,
    #                oga, ruby-ll, psych, websocket-driver): headers of the
    #                exact ruby the runtime ships (the runtime image carries
    #                none). The windows leg additionally generates an import
    #                library from the facet DLL's own export table with
    #                dlltool (docs/build-notes.md § Windows). sha256 == the
    #                source-factory SSOT (tamatebako/ruby versions.yml).
    default_line: "4.0"      # 2026-09-27 flip: ruby 4.0 is measurably faster
                             # and the line is proven (dual-line publish since
                             # 1.16.9, both ABI lines dogfood-gated) — the bare
                             # 1.17.0 entry now rides 4.0.7; the 3.3 flavor
                             # keeps publishing as 1.17.0-ruby3.3 for the
                             # conservative chain.
    # The CLI's SDK provisioning (tebako-cli sdk.rs) fetches the patched
    # source tarball per ruby version from THIS source-factory release —
    # 4.0.7's src first ships in v0.2.36; v0.2.38 is the current line.
    # (The CLI's built-in default predates 4.0.7; this pin is the
    # feedstock's SSOT until a product release re-floors the default.)
    sdk_src_release: "v0.2.38"
    lines:
      "3.3":
        version: "3.3.12"
        constraint: "~> 3.3.0"
        sdk:
          url: "https://cache.ruby-lang.org/pub/ruby/3.3/ruby-3.3.12.tar.gz"
          sha256: "b06d63beae271933033e27f0a389bc582a009e7845357d44365c39de525a051b"
      "4.0":
        version: "4.0.7"
        constraint: "~> 4.0.0"
        sdk:
          url: "https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.7.tar.gz"
          sha256: "911ace20f90d068ca0e4dda6d0e4f0f81e52e52f2dd4f4004c721e253412e82d"
  # libyaml for psych 5.2.6 (psych ships no precompiled gems and vendors no
  # libyaml; see docs/build-notes.md §3). mac leg: --with-libyaml-source-dir
  # inside the gem build; windows leg: host-built static libyaml + dir_config
  # (a mingw ruby cannot exec libyaml's configure in-process).
  libyaml:
    url: "https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz"
    sha256: "c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4"
  # Resolution overrides, each justified in docs/build-notes.md:
  pins:
    liquid: "5.6.0"        # >= 5.6.1 demands strscan >= 3.1.1 (source-only native)
    metanorma: "2.5.4"     # portfolio directive materialisation (metanorma#596):
                           # absolute pdf-portfolio cover/keystore paths are
                           # copied into the output folder so external readers
                           # (mn2pdf's JVM) never dereference an in-VFS gem path
  # Constraints the runtime's own default/bundled gems already satisfy — the
  # payload relies on the runtime for these (runtime-required kind: app).
  # Shared by both ruby lines today; if a future line's default-gem set
  # drifts (a skip unsatisfied, or a pin made moot), the override shape is a
  # per-line `pins:`/`skip_defaults:` block under build.runtime.lines.<line>
  # merged over these — derive the delta from the line runtime's own
  # `gem list --default`, never by guess (docs/build-notes.md §9).
  skip_defaults: [json, bigdecimal, strscan, racc, drb, uri, minitest,
                  securerandom, benchmark, ostruct, rexml, date, time,
                  nkf, reline, io-console, prism,
                  stringio, timeout, yaml, singleton, ruby2_keywords,
                  readline, net-protocol, matrix]

# Feedstock deps consumed at exec time (spec 03 DEPENDS; the dispatcher
# mounts the toolkit payload at the consumer-declared point).
depends:
  # spec 32's first instance: the ietf chain's xml2rfc spawn edge.
  # Expose-only (never co-mounted): the provider payload dispatches as a
  # child through its own spec-17 composition on the python runtime.
  # Resolution at install/publish-verify rides the xml2rfc feedstock's
  # registry + the python runtime mirror — the permanent wiring (the
  # python: block below + the publish/dogfood steps) landed with the
  # python factory's first published line (v0.1.0). The triplets:
  # conditioning (documentary shadow of manifests/payload.yaml, the
  # operative copy) skips the edge on windows hosts — no ucrt provider
  # payload exists (tebako-runtime-python#23).
  - kind: executable
    name: xml2rfc
    payload: xml2rfc
    constraint: ">= 3.34"
    expose: [xml2rfc]
    critical: true
    triplets: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-linux-musl,
               aarch64-linux-musl, x86_64-macos, aarch64-macos]

# Factory tools used by tools/build (image creation + the packager): the
# tebako/tfs CLIs from the tamatebako/tebako release (the tfs CLI's
# in-process writer — limnifs, the default format — images all legs). The asset digests are
# pinned HERE — tools.sha256 is the repo's toolchain pin SSOT (the
# workflows carry no version or digest literals; tools/pins.rb reads
# this block into $GITHUB_ENV) and cross-checked against the release's
# SHA256SUMS at fetch time (the same trust-anchor role as
# upstream.sha256; provenance in docs/build-notes.md).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.24"         # v2.8.24 ships spec 38's publish --oci (the
                             # dual-publish leg the OCI_REPO variable arms)
                             # + spec 39's blksum sidecar staging beside
                             # every payload image. v2.8.22 presses ruby
                             # 4.0.7 (the 0.16.31
                             # line's 4.0 tip — v2.8.21's table exits 110
                             # on it). v2.8.21's imager writes limnifs
                             # metadata
                             # inlined up to the 64 MiB product ceiling
                             # (this payload's blob is ≈7.9 MiB — older
                             # tools externalize it and the self-contained
                             # image cannot carry the sidecar), and its
                             # resolver speaks the shard-era registry
                             # grammar: runtime entries carry
                             # platform-keyed artifact+sha256 inline and
                             # no release-root manifest.json is fetched
                             # (the python factory's relayout removed it —
                             # older pins exit 69 resolving the spawned
                             # runtimes). Carries v2.8.18's shim bundle-row
                             # split (tebako#673), the extension-slice
                             # tooling + the zero-interaction trust plane
                             # the publish-signing leg needs.
  sha256:
