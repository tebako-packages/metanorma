# Feedstock recipe for metanorma
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "metanorma"
kind: app
summary: "Metanorma — the standards-document authoring CLI (ruby app; runtime-required payload)"

upstream:
  # RubyGems closure, not a tarball: the dependency set is resolved from the
  # rubygems compact index and every .gem is sha256-verified against the
  # /info/<gem> checksum before use (tools/build).
  gem: "metanorma-cli"
  version: "1.17.0"
  source: "https://rubygems.org"

build:
  system: gemstage         # stage a GEM_HOME closure with a tebako runtime's own ruby
  runtime:
    engine: ruby
    tebako: "0.16.24"      # runtime release line (image-era; the pinned CLI
                           # refuses pre-era releases by contract, exit 75).
                           # 0.16.24 re-cuts the signed line on the tebako
                           # v2.8.7 link unit (the windows 0xC0000139
                           # mount-boundary repair) — the first line whose
                           # shards declare OpenPGP signature facets.
                           # 0.16.23 is the SIGNED re-cut of the 0.16.22
                           # line (spec 09 §9 publish signing + spec 34
                           # OS-plane signing — same sources, new assets).
                           # 0.16.22 is the factory re-cut on the tebako
                           # v2.2.0 link unit (the spec-32 driver plan +
                           # schema_minor-5 parse) — it UNBLOCKS the
                           # xml2rfc executable edge below: pre-0.16.22
                           # exes refused the manifest at boot by name
                           # ("requires.[3].kind: unknown variant
                           # `executable`" — proven 2026-09-05 with the
                           # local spec-32 build on the 0.16.19/0.16.21
                           # lines; 0.16.21 still rode the tebako v2.1.5
                           # link unit per the factory's contract.yml
                           # link_unit_release). 0.16.18 carries the tebako
                           # v2.1.0 link unit AND the spec-30 spawn FFI
                           # head (ruby#106's process_c_tebako_spawn patch
                           # — array-form spawns of an exposed command
                           # offer the driver's plan FIRST; without it the
                           # java edge cannot intercept mn2pdf/jing's
                           # spawns on POSIX). Ruby source pin v0.2.32.
                           # 0.16.19 rides the tebako v2.1.5 link unit
                           # (tebako#516: the realpath NULL-buffer arm
                           # routes to canonicalize_file_name — the
                           # glibc ≤ 2.31 compat-twin EINVAL that refused
                           # every jailed spawn, exit 78, on the factory
                           # floor; tebako#517 scopes that reroute to gnu —
                           # musl has no canonicalize_file_name at all and
                           # its plain-dlsym arm is already unambiguous, so
                           # the v2.1.4 musl unit's constructor panicked on
                           # the RTLD_NEXT lookup; tebako#515's realpath
                           # family + vfork gate included).
    # The ruby axis (roadmap 77): ONE upstream version publishes ONE
    # registry version entry per line — the default line keeps the bare
    # upstream version (1.17.0), every other line suffixes "-ruby<line>"
    # (1.17.0-ruby4.0). Users choose through the existing spec 07 §2.1
    # version chain; each flavor's entrypoint runtime_requirement fills
    # from the line's `constraint` (spec 28 §8's native law locks each
    # flavor to its own ABI line — never cross-paired). Per line:
    #   version    — the staging + exec runtime (tebako-runtime-ruby)
    #   constraint — the ABI line declared on every entrypoint
    #   sdk        — mkmf SDK for the source-built native deps (brotli, ox,
    #                oga, ruby-ll, psych, websocket-driver): headers of the
    #                exact ruby the runtime ships (the runtime image carries
    #                none). The windows leg additionally generates an import
    #                library from the facet DLL's own export table with
    #                dlltool (docs/build-notes.md § Windows). sha256 == the
    #                source-factory SSOT (tamatebako/ruby versions.yml).
    default_line: "3.3"
    lines:
      "3.3":
        version: "3.3.12"
        constraint: "~> 3.3.0"
        sdk:
          url: "https://cache.ruby-lang.org/pub/ruby/3.3/ruby-3.3.12.tar.gz"
          sha256: "b06d63beae271933033e27f0a389bc582a009e7845357d44365c39de525a051b"
      "4.0":
        version: "4.0.6"
        constraint: "~> 4.0.0"
        sdk:
          url: "https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.6.tar.gz"
          sha256: "837d299e8f7ddf2be31a229a7a7e019d354979825117989acb3b32b1a9be262a"
  # libyaml for psych 5.2.6 (psych ships no precompiled gems and vendors no
  # libyaml; see docs/build-notes.md §3). mac leg: --with-libyaml-source-dir
  # inside the gem build; windows leg: host-built static libyaml + dir_config
  # (a mingw ruby cannot exec libyaml's configure in-process).
  libyaml:
    url: "https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz"
    sha256: "c642ae9b75fee120b2d96c712538bd2cf283228d2337df2cf2988e3c02678ef4"
  # Resolution overrides, each justified in docs/build-notes.md:
  pins:
    liquid: "5.6.0"        # >= 5.6.1 demands strscan >= 3.1.1 (source-only native)
    metanorma: "2.5.4"     # portfolio directive materialisation (metanorma#596):
                           # absolute pdf-portfolio cover/keystore paths are
                           # copied into the output folder so external readers
                           # (mn2pdf's JVM) never dereference an in-VFS gem path
  # Constraints the runtime's own default/bundled gems already satisfy — the
  # payload relies on the runtime for these (runtime-required kind: app).
  # Shared by both ruby lines today; if a future line's default-gem set
  # drifts (a skip unsatisfied, or a pin made moot), the override shape is a
  # per-line `pins:`/`skip_defaults:` block under build.runtime.lines.<line>
  # merged over these — derive the delta from the line runtime's own
  # `gem list --default`, never by guess (docs/build-notes.md §9).
  skip_defaults: [json, bigdecimal, strscan, racc, drb, uri, minitest,
                  securerandom, benchmark, ostruct, rexml, date, time,
                  nkf, reline, io-console, prism,
                  stringio, timeout, yaml, singleton, ruby2_keywords,
                  readline, net-protocol, matrix]

# Feedstock deps consumed at exec time (spec 03 DEPENDS; the dispatcher
# mounts the toolkit payload at the consumer-declared point).
depends:
  - kind: toolkit
    name: inkscape
    constraint: ">= 1.3"
    mount: /opt/inkscape
  # spec 32's first instance: the ietf chain's xml2rfc spawn edge.
  # Expose-only (never co-mounted): the provider payload dispatches as a
  # child through its own spec-17 composition on the python runtime.
  # Resolution at install/publish-verify rides the xml2rfc feedstock's
  # registry + the python runtime mirror — the permanent wiring (the
  # python: block below + the publish/dogfood steps) landed with the
  # python factory's first published line (v0.1.0). The triplets:
  # conditioning (documentary shadow of manifests/payload.yaml, the
  # operative copy) skips the edge on windows hosts — no ucrt provider
  # payload exists (tebako-runtime-python#23).
  - kind: executable
    name: xml2rfc
    payload: xml2rfc
    constraint: ">= 3.34"
    expose: [xml2rfc]
    critical: true
    triplets: [x86_64-linux-gnu, aarch64-linux-gnu, x86_64-linux-musl,
               aarch64-linux-musl, x86_64-macos, aarch64-macos]

# Factory tools used by tools/build (image creation + the packager): the
# tebako/tfs CLIs from the tamatebako/tebako release (the tfs CLI's
# in-process dwarfs-t Writer images both legs). The asset digests are
# pinned HERE — tools.sha256 is the repo's toolchain pin SSOT (the
# workflows carry no version or digest literals; tools/pins.rb reads
# this block into $GITHUB_ENV) and cross-checked against the release's
# SHA256SUMS at fetch time (the same trust-anchor role as
# upstream.sha256; provenance in docs/build-notes.md).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.17"         # v2.8.17's resolver speaks the shard-era
                             # registry grammar: runtime entries carry
                             # platform-keyed artifact+sha256 inline and
                             # no release-root manifest.json is fetched
                             # (the python factory's relayout removed it —
                             # older pins exit 69 resolving the spawned
                             # runtimes). Still carries the extension-slice
                             # tooling + the zero-interaction trust plane
                             # the publish-signing leg needs.
  sha256:
    tebako:
      macos-arm64: "a94a9ec6b12fcff1d3c8889befebcc8f6d306bfc81a47696cd4268c97682cccd"
      linux-gnu-x86_64: "355c81b97d86c4a76f215e46b9570cf4f30df44d5bb086c13459ff7e0de12929"
      windows-ucrt64: "2dd60a74b1b3da91dc3d3ff8b8e5d6a35458f69f6a379c2536f8410e95f890c0"
    tebako-shim:
      macos-arm64: "cb7b888bb31916b58b79dec99e6b7baf97d1280bea9bb31768ec8ddef3769071"
      linux-gnu-x86_64: "9a3599f815f6246929ea69e5c39379b5ba5161997756b57b923e524c706fbc03"
      windows-ucrt64: "129dd752bd9d971df592c876082d2fc179b94177dbe0db57faeeb44672f19505"
    tfs:
      macos-arm64: "f2c957bd27a3b2fea871e04bdf5c8de3689a8327a1474ca698e3936eaf239661"
      linux-gnu-x86_64: "083e4886f751901493d124cf90f8dc20a88fb9ba0877db9af1a5b42d0c1d64db"
      windows-ucrt64: "5ba7d570621ca39de15e680d1206c21d4b9ac571aef2a639ad94a68c2683f7c7"

# The spawned java runtime behind payload.yaml's kind: runtime edge: the
# openjdk feedstock's release line, consumed through the resolver's
# {base}/v<tebako_version>/<asset> URL shape (spec 13 §2a). The workflows
# scope this as TEBAKO_RUNTIME_MIRROR to install/publish-verify steps
# ONLY — never at dispatch/compile time, where the primary ruby runtime's
# download would be misdirected (the mirror is one base for ALL engines;
# a per-engine source key in config.yaml is the filed product follow-up).
java:
  # The pinned java runtime pair (tamatebako/tebako-runtime-openjdk
  # release v2.7.0 — the runtime feedstock's canonical home per the
  # 2026-09-10 org split; tebako-packages/openjdk redirects there —
  # kind: runtime, the spec 30 spawn edge in manifests/payload.yaml).
  # v2.4.0 is the oldest line whose launcher parses spec 32: the spawned
  # JVM co-mounts THIS payload (mn2pdf's jar lives in its image) and its
  # launcher parses the payload manifest — v2.1.5 predates spec 32 and
  # dies "unknown variant 'executable'" (the 2026-09-10 full-dogfood
  # failure). v2.7.0 is the first line that is BOTH signed (spec 09 §9
  # .asc sidecars + Authenticode on the windows exe) AND tag==line
  # consumable: v2.5.1 signed the 2.5.0 line under a mismatched tag, so
  # this recipe's composed-name fetch 404'd (the 1.16.9-11 publish, run
  # 34683540428); v2.7.0 relines the pair onto the v2.7.0 product and
  # the feedstock guards the invariant at publish. The pin advances for
  # the REQUIRE_SIGNED=1 acceptance. v2.4.1+ lists a graalvm sibling
  # flavor in manifest.json (25.0.4.1 outranks 21.0.12 by version), so
  # the payload's java edge names `implementation: temurin` (spec 28
  # §8): the validated flavor matches, graalvm never silently picked.
  # The preference flows into ~/.tebako/config.yaml `runtimes:` at
  # install/publish time so the edge's download resolves to THIS exact
  # pair (a pref-less pick would query the wrong release line).
  version: "21.0.12"       # Temurin JRE 21.0.12+8 repack
  tebako: "2.7.0"          # the release line = the wrapper's tebako build
  releases_base: "https://github.com/tamatebako/tebako-runtime-openjdk/releases/download"

# The nested python runtime behind payload.yaml's spec-32 kind: executable
# edge (the xml2rfc provider dispatches as a child on its own python
# runtime): the tebako-runtime-python factory's first published line,
# consumed through the same {base}/v<tebako_version>/<asset> URL shape as
# the java block. Same scoping law: the workflows feed this to
# TEBAKO_RUNTIME_MIRROR at install/publish steps ONLY (one base for ALL
# engines — the publish/dogfood steps stage a COMBINED local mirror with
# the java leg so both spawned edges resolve), and the preference flows
# into ~/.tebako/config.yaml `runtimes:` so the nested edge resolves to
# THIS exact pair (a pref-less pick queries the default line, which hosts
# no python).
python:
  version: "3.14.7"        # the xml2rfc provider's staging + exec line
                           # (follows the provider: xml2rfc 3.34.1 stages
                           # on 3.14.7 with the ABI edge ~> 3.14.0)
  tebako: "0.2.0"          # tebako-runtime-python's current line (v0.2.0
                           # — the shard-model, per-leg-signed release;
                           # v0.1.3 before it was the first signed line)
  releases_base: "https://github.com/tamatebako/tebako-runtime-python/releases/download"

# Signing (spec 09 §9 — opt-in per feedstock): on tag pushes the publish
# step signs every payload image (plus SHA256SUMS and the registry itself)
# with the CI signing subkey of the tamatebako root, supplied as the org
# secret TEBAKO_CI_SIGNING_KEY, and the registry pins the PRIMARY keyid
# (the identity, not the rotating subkey instrument). A declared signing
# block with an absent secret FAILS the publish — a signing feedstock
# never ships an unsigned release silently. No signing.tool sub-block
# (hello needed a separate signer binary): the publisher IS the tools
# block's pinned tebako CLI — v2.6.0, the first release whose embedded
# root public key verifies the registry's signature pins at the publish's
# own clean-cache verify.
signing:
  keyid: "efc3c250f7862a48" # 2026-09-09 tamatebako root primary (low 64)

platforms:
  - aarch64-macos          # triplet-bound (nokogiri/ffi/libpng/parsanol/sqlite3/
                           # leptris/yeptris precompiled; brotli/ox/oga/ruby-ll/
                           # psych/websocket-driver compiled per-triplet). More
                           # triplets: CI legs.
  - x86_64-linux-gnu       # built by CI (ubuntu-24.04): the POSIX shim
                           # staging, same shape as the mac leg — the
                           # CLI-provisioned runtime SDK supplies the mkmf
                           # inputs; precompiled natives swapped for their
                           # glibc-x86_64 variants (closure file)
  - x86_64-windows-ucrt    # built by CI (green incl. the six source-built
                           # natives); the boot smoke is ENFORCED on this
                           # runtime line (the W2 windows fixes landed in
                           # 0.16.4); published since the 1.16.9 line
                           # (docs/build-notes.md § Windows)

provides:
  # Informational shadow of the payload's command surface — the
  # AUTHORITATIVE declaration is manifests/payload.yaml (the complete
  # 66-command inventory with per-entrypoint `active` exposure, spec 03
  # §2.2), which tools/build fills into the image and `tebako publish`
  # mirrors into the registry. Do NOT grow this list here.
  # identity.version and each entrypoint's runtime_requirement are PER-LINE
  # (roadmap 77): they flow from build.runtime.lines (version →
  # 1.17.0 / 1.17.0-ruby4.0, constraint → the line's ABI line) through
  # tools/build's @@PAYLOAD_VERSION@@/@@CONSTRAINT@@ fill — one owner, no
  # second copy here.
  entrypoints:
    - name: "metanorma"
      path: "/bin/metanorma"
    - name: "fontist"
      path: "/bin/fontist"

annotations:
  gem: metanorma-cli
  gem_version: "1.17.0"
